---
import Layout from '../layouts/Layout.astro';
import Syllabus from '../components/Syllabus.astro';
import { topics, chapters } from '../data/topics';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---

<Layout
	title="Rangkuman Materi — Persiapan UTS Manajemen Bisnis"
	description="Rangkuman Manajemen Bisnis per topik:16 topik dalam 5 bagian, disusun dari 19 file materi kuliah."
	active="rangkuman"
	crumb="Rangkuman · 16 Topik"
	heading="Rangkuman Materi"
	subheading={`${topics.length} topik dari 19 file materi kuliah, tersusun dalam ${chapters.length} bagian. Pilih topik untuk mulai membaca.`}
>
	<div class="wrap page-body">
		<p class="note">
			Cari cepat: tekan <b>Ctrl + K</b> atau tombol <b>Cari</b> di atas, lalu ketik judul atau
			kata dari isi materi.
		</p>
		<Syllabus base={base} />
	</div>
</Layout>
