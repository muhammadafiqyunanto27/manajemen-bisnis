---
import Layout from '../layouts/Layout.astro';
import Syllabus from '../components/Syllabus.astro';
import { topics } from '../data/topics';
import { soalUts } from '../data/soalUts';
import { latihanSoal } from '../data/latihanSoal';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const pakets = new Set(latihanSoal.map((s) => s.paket)).size;
---

<Layout title="Persiapan UTS — Manajemen Bisnis" active="home">
	<header class="hero">
		<div class="wrap">
			<span class="hero-kicker">Modul Belajar · Manajemen Bisnis</span>
			<h1>Persiapan UTS Manajemen Bisnis</h1>
			<p class="lead">
				Rangkuman 19 file materi kuliah, quote tokoh, jawaban Soal UTS, dan latihan soal —
				disusun rapi, satu topik satu halaman, plus Mode Kilat buat latihan cepat.
			</p>
			<div class="hero-cta">
				<a class="btn btn-solid" href={`${base}/rangkuman`}>Buka Rangkuman</a>
				<a class="btn btn-ghost" href={`${base}/latihan`}>Latihan Soal</a>
			</div>
			<div class="badges">
				<span>{topics.length} Topik Rangkuman</span>
				<span>{soalUts.length} Jawaban Soal UTS</span>
				<span>{latihanSoal.length} Latihan Soal · {pakets} Paket</span>
				<span>Mode Terang &amp; Gelap</span>
			</div>
		</div>
	</header>

	<div class="wrap page-body">
		<div class="sec-title">
			<h2>Daftar Materi</h2>
			<span class="sec-hint">5 bagian · {topics.length} topik — klik untuk mulai membaca</span>
		</div>
		<p class="note">
			Mau cepat? Tekan <b>Ctrl + K</b> atau tombol <b>Cari</b> di atas — bisa cari dari judul
			maupun isi materi.
		</p>
		<Syllabus base={base} />

		<div class="sec-title">
			<h2>Latihan &amp; Ujian</h2>
			<span class="sec-hint">Mode Kilat + kunci jawaban lengkap</span>
		</div>
		<div class="quick-grid">
			<a class="quick-card" href={`${base}/soal-uts`}>
				<span class="quick-num">{soalUts.length}</span>
				<span class="quick-body">
					<b>Jawaban Soal UTS</b>
					<small>Semua soal UTS dijawab lengkap per poin — bisa dibaca santai atau diuji lewat Mode Kilat.</small>
				</span>
			</a>
			<a class="quick-card" href={`${base}/latihan`}>
				<span class="quick-num">{latihanSoal.length}</span>
				<span class="quick-body">
					<b>Latihan Soal</b>
					<small>{latihanSoal.length} soal dalam {pakets} paket — kerjakan dulu, buka kunci jawabannya sesudahnya.</small>
				</span>
			</a>
		</div>
	</div>
</Layout>
