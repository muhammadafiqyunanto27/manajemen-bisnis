---
import Layout from '../layouts/Layout.astro';
import QuizKilat from '../components/QuizKilat.tsx';

const soalUts = [
	{
		"label": "Soal 1 — a",
		"q": "<p>Jelaskan komponen utama dalam konsep bisnis! Apa saja jenis bisnis itu?\n</p>",
		"a": "<p><b>Komponen Utama Konsep Bisnis</b> — sebuah usaha bisa berjalan baik jika memiliki empat komponen utama:\n</p>\n\n<ol>\n\n<li><b>Strategi Inti (core strategy)</b> — visi dan misi bisnis, meliputi hal yang diharapkan dari bisnis yang bersifat ideal (arah, tujuan, dan posisi yang hendak dicapai).\n</li>\n\n<li><b>Sumber Daya Strategis (strategic resources)</b> — terdiri dari kompetensi inti, aset strategis, dan proses utama; mencakup modal, SDM, teknologi, serta kemampuan unik yang menjadi kekuatan persaingan perusahaan.\n</li>\n\n<li><b>Perantara Pelanggan (customer interface)</b> — dukungan dan pemenuhan, informasi yang mendalam, dinamika hubungan, dan struktur harga; cara perusahaan berinteraksi, melayani, dan mempertahankan pelanggan.\n</li>\n\n<li><b>Jaringan Nilai (value network)</b> — jaringan nilai di sekitar perusahaan (mitra, pemasok, aliansi) yang memperkuat dan melengkapi sumber daya yang dimiliki perusahaan.\n</li>\n\n</ol>\n\n<h4>Jenis-Jenis Bisnis\n</h4>\n\n<p><b>Berdasarkan aktivitasnya:</b>\n</p>\n\n<ul>\n\n<li><b>Bisnis Ekstraktif</b> — pertambangan/penggalian barang tambang (batu bara, minyak, emas).\n</li>\n\n<li><b>Bisnis Manufaktur</b> — produksi, mengubah bahan mentah menjadi barang jadi.\n</li>\n\n<li><b>Bisnis Jasa</b> — penyediaan layanan (konsultan, salon, rumah sakit).\n</li>\n\n</ul>\n\n<p><b>Berdasarkan cara berjualan &amp; model:</b>\n</p>\n\n<ul>\n\n<li><b>E-Commerce</b> — penjualan online via platform elektronik.\n</li>\n\n<li><b>Retail/Ritel</b> — penjualan langsung ke konsumen akhir (supermarket, toko pakaian).\n</li>\n\n<li><b>Franchise/Waralaba</b> — pemberian lisensi merek, produk, dan sistem ke pihak ketiga (McDonald's, KFC).\n</li>\n\n<li><b>Startup</b> — bisnis baru yang berfokus pada inovasi produk/layanan berpotensi tumbuh pesat.\n</li>\n\n</ul>\n\n<h4>Pelengkap — Business Model Canvas\n</h4>\n\n<p>Keempat komponen di atas dipraktikkan lewat model bisnis 9 bagian (Osterwalder):\n</p>\n\n<div class=\"bmc\">\n\n<div class=\"bmc-canvas\">\n\n<div class=\"bmc-cell bmc-partners\">\n<h5>Key Partners\n</h5>\n<ul>\n<li>Pemasok\n</li>\n<li>Mitra &amp; aliansi strategis\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-activities\">\n<h5>Key Activities\n</h5>\n<ul>\n<li>Produksi &amp; operasi\n</li>\n<li>Pemasaran &amp; R&amp;D\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-resources\">\n<h5>Key Resources\n</h5>\n<ul>\n<li>Modal, SDM, teknologi\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-vp\">\n<h5>Value Proposition\n</h5>\n<ul>\n<li>Solusi unik atas masalah pelanggan\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-relationships\">\n<h5>Customer Relationships\n</h5>\n<ul>\n<li>Layanan personal &amp; loyalitas\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-channels\">\n<h5>Channels\n</h5>\n<ul>\n<li>Online, offline, perantara\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-segments\">\n<h5>Customer Segments\n</h5>\n<ul>\n<li>Target pasar per segmen\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-cost\">\n<h5>Cost Structure\n</h5>\n<ul>\n<li>Biaya tetap &amp; variabel operasional\n</li>\n</ul>\n</div>\n\n<div class=\"bmc-cell bmc-revenue\">\n<h5>Revenue Streams\n</h5>\n<ul>\n<li>Penjualan, langganan, iklan\n</li>\n</ul>\n</div>\n\n</div>\n\n<div class=\"bmc-map\"><b>Pemetaan ke 4 komponen konsep bisnis:</b> Strategi Inti → Value Proposition + Customer Segments • Sumber Daya Strategis → Key Resources + Key Activities • Perantara Pelanggan → Channels + Customer Relationships • Jaringan Nilai → Key Partners. Cost Structure &amp; Revenue Streams menjadi fondasi finansialnya.\n</div>\n\n</div>"
	},
	{
		"label": "Soal 1 — b",
		"q": "<p>Sebutkan dan jelaskan komponen lingkungan bisnis! Jelaskan lingkungan eksternal mikro dan makro!\n</p>",
		"a": "<p><b>Komponen Lingkungan Bisnis</b> terdiri dari lingkungan internal dan lingkungan eksternal.\n</p>\n\n<h4>A. Lingkungan Internal\n</h4>\n\n<p>Komponen di dalam perusahaan:\n</p>\n\n<ol>\n\n<li><b>Sistem nilai</b> — pemilihan bisnis, misi, visi, kebijakan &amp; praktik.\n</li>\n\n<li><b>Misi, visi &amp; tujuan.</b>\n</li>\n\n<li><b>Struktur &amp; sifat kepengurusan</b> — dewan direksi, manajer.\n</li>\n\n<li><b>Hubungan kekuatan internal</b> — koordinasi timbal balik antar tingkatan.\n</li>\n\n<li><b>Sumber daya manusia</b> — komponen kunci: keterampilan, komitmen, sikap.\n</li>\n\n<li><b>Citra perusahaan &amp; ekuitas merek.</b>\n</li>\n\n<li><b>Faktor lain</b> — aset &amp; fasilitas fisik, R&amp;D, sumber daya pemasaran, faktor keuangan.\n</li>\n\n</ol>\n\n<h4>B. Lingkungan Eksternal Mikro\n</h4>\n\n<p>Elemen yang berinteraksi langsung dengan perusahaan:\n</p>\n\n<ol>\n\n<li><b>Pelanggan</b> — elemen terpenting; tujuan utama bisnis adalah menarik &amp; mempertahankan pelanggan.\n</li>\n\n<li><b>Pemasok</b> — pemasok bahan baku, komponen &amp; mesin; harus dapat dipercaya &amp; ramah.\n</li>\n\n<li><b>Perantara pemasaran</b> — mediator antara produsen &amp; konsumen akhir.\n</li>\n\n<li><b>Pesaing</b> — organisasi yang memproduksi produk serupa &amp; berebut pangsa pasar.\n</li>\n\n<li><b>Masyarakat umum</b> — respon masyarakat memengaruhi citra, penjualan &amp; pendapatan.\n</li>\n\n</ol>\n\n\n<p><b>C. Lingkungan Eksternal Makro</b> — faktor luas di luar kendali perusahaan:\n</p>\n\n<ol>\n\n<li><b>Politik</b> — pemerintah, lembaga politik, kebijakan &amp; legislasi (pajak, kontrak pemerintah).\n</li>\n\n<li><b>Ekonomi</b> — tingkat ekonomi, pengangguran, nilai tukar asing, inflasi &amp; deflasi.\n</li>\n\n<li><b>Sosial</b> — adat, nilai masyarakat, perubahan selera, standar hidup, pendidikan.\n</li>\n\n<li><b>Teknologi</b> — peralatan, teknologi &amp; teknik produksi yang ditingkatkan.\n</li>\n\n<li><b>Fisik</b> — bencana alam &amp; perubahan lingkungan yang memengaruhi produksi/pasokan.\n</li>\n\n<li><b>Hukum</b> — peraturan yang wajib dipatuhi (UU Merek Dagang, Komoditas Esensial, dll).\n</li>\n\n<li><b>Internasional</b> — sistem hukum/politik lintas negara, kebijakan ekonomi, budaya, tarif, perjanjian perdagangan.\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 2 — a",
		"q": "<p>Dalam manajemen bisnis ada perencanaan strategis, apa saja isi perencanaan strategis? Mengapa perencanaan itu penting dalam bisnis?\n</p>",
		"a": "<p><b>Isi Perencanaan Strategis</b> — strategi adalah \"penetapan tujuan jangka panjang yang mendasar dari suatu organisasi, dan pemilihan alternatif tindakan serta alokasi sumber daya untuk mencapainya\". Isi/proses perencanaan strategis meliputi:\n</p>\n\n<ol>\n\n<li><b>Formulasi Misi dan Tujuan</b> — berfokus pada pasar, dapat dicapai, dapat memotivasi, dan spesifik.\n</li>\n\n<li><b>Analisis Tujuan dan Strategi Saat Ini</b> — evaluasi apakah tujuan &amp; strategi yang berjalan sudah sesuai seharusnya.\n</li>\n\n<li><b>Analisis Lingkungan</b> — mengidentifikasi perubahan lingkungan &amp; kesempatan strategis yang bisa dimanfaatkan.\n</li>\n\n<li><b>Analisis Sumber Daya</b> — melihat kekuatan sumber daya organisasi relatif terhadap pesaing.\n</li>\n\n<li><b>Identifikasi Kesempatan Strategis</b> — muncul bila ada <i>gap</i> antara hasil strategi saat ini dengan hasil bila strategi lain (yang seharusnya) digunakan.\n</li>\n\n<li><b>Pengambilan Keputusan Strategis</b> — mengembangkan &amp; memilih alternatif keputusan terbaik.\n</li>\n\n<li><b>Pelaksanaan Strategi</b> — menjalankan alternatif terbaik untuk mencapai tujuan.\n</li>\n\n<li><b>Evaluasi dan Pengendalian Strategis</b> — memastikan pelaksanaan sesuai rencana &amp; mencapai tujuan yang diinginkan.\n</li>\n\n</ol>\n\n<h4>3 Tingkatan Strategi\n</h4>\n\n<ul>\n\n<li><b>Korporasi</b> — menentukan pasar mana yang akan dimasuki.\n</li>\n\n<li><b>Unit Bisnis</b> — menentukan bagaimana bersaing di pasar tersebut.\n</li>\n\n<li><b>Fungsional</b> — menjalankan setiap fungsi operasional untuk mendukung strategi di atasnya.\n</li>\n\n</ul>\n\n<h4>Mengapa Perencanaan Penting\n</h4>\n\n<ol>\n\n<li><b>Memberi arah</b> — manajer &amp; karyawan tahu kemana organisasi menuju sehingga kegiatan dapat dikoordinasikan.\n</li>\n\n<li><b>Mengurangi ketidakpastian</b> — mendorong melihat ke depan, mengantisipasi perubahan, dan menyusun tanggapan yang tepat.\n</li>\n\n<li><b>Mengurangi kegiatan tumpang tindih</b> — ketidakefisienan menjadi jelas dan mudah dikoreksi.\n</li>\n\n<li><b>Menentukan standar untuk pengendalian</b> — kinerja aktual dapat dibandingkan dengan sasaran; penyimpangan teridentifikasi &amp; tindakan koreksi diambil.\n</li>\n\n</ol>\n\n<p>Selain itu perencanaan menghasilkan <b>\"protective benefits\"</b> (mengurangi kesalahan pengambilan keputusan) dan <b>\"positive benefits\"</b> (meningkatkan sukses pencapaian tujuan organisasi). Sesuai kata Abraham Lincoln: <i>\"Give me six hours to cut down a tree and I will spend the first four sharpening the axe.\"</i>\n</p>"
	},
	{
		"label": "Soal 2 — b",
		"q": "<p>Jelaskan Gaya Kepemimpinan Kontingensi menurut Hersey and Blanchard!\n</p>",
		"a": "<p><b>Gaya Kepemimpinan Situasional (Contingency) menurut Hersey &amp; Blanchard</b> (dalam Veithzal Rivai, 2014) adalah gaya kepemimpinan di mana <b>pemimpin/manajer harus menyesuaikan responnya menurut kondisi atau tingkat perkembangan kematangan, kemampuan, dan minat karyawan</b> dalam menyelesaikan tugas-tugasnya. Tidak ada gaya yang optimal untuk semua situasi — gaya yang tepat bergantung pada tingkat kesiapan/kematangan bawahan.\n</p>\n\n<h4>Asumsi Dasar\n</h4>\n\n<p>Perilaku kepemimpinan merupakan kombinasi tiga dimensi:\n</p>\n\n<ol>\n\n<li>Banyaknya <b>pengarahan</b> yang diberikan.\n</li>\n\n<li>Banyaknya <b>dukungan</b> yang diberikan.\n</li>\n\n<li><b>Tingkat kematangan bawahan</b> — kombinasi kemauan &amp; kemampuan.\n</li>\n\n</ol>\n\n<h4>4 Gaya Kepemimpinan\n</h4>\n\n<ol>\n\n<li><b>S1: Telling (Pemberitahu)</b> — Pengarahan Tinggi, Dukungan Rendah. Komunikasi satu arah; pemimpin memberitahu apa, bagaimana, mengapa, kapan &amp; dimana pekerjaan dilaksanakan; instruksi jelas &amp; pengawasan langsung. <b>Sesuai untuk kesiapan rendah (R1)</b> — pengikut tidak mampu &amp; tidak mau (K1).\n</li>\n\n<li><b>S2: Selling (Penjual)</b> — Pengarahan Tinggi, Dukungan Tinggi. Masih memberi arahan tetapi dengan komunikasi dua arah &amp; dukungan emosional untuk memotivasi &amp; membangun percaya diri. <b>Sesuai untuk kesiapan moderat (R2)</b> — mau tetapi tidak mampu (K2).\n</li>\n\n<li><b>S3: Participating (Partisipatif)</b> — Pengarahan Rendah, Dukungan Tinggi. Mendorong saling berbagi gagasan &amp; memfasilitasi; pemimpin menjadi pendengar yang baik &amp; memelihara hubungan. <b>Sesuai untuk kesiapan tinggi dengan motivasi moderat (R3)</b> — mampu tetapi tidak mau (K3).\n</li>\n\n<li><b>S4: Delegating (Pendelegasian)</b> — Pengarahan Rendah, Dukungan Rendah. Mengalihkan tanggung jawab keputusan &amp; pelaksanaan kepada pengikut; pemimpin hanya memonitor. <b>Sesuai untuk kesiapan tinggi (R4)</b> — mampu &amp; mau (K4).\n</li>\n\n</ol>\n\n<h4>4 Tingkat Kesiapan Pengikut (Follower Readiness)\n</h4>\n\n<table>\n\n<tr>\n<th>Kesiapan\n</th>\n<th>Kemampuan\n</th>\n<th>Kemauan\n</th>\n<th>Gaya yang Cocok\n</th>\n</tr>\n\n<tr>\n<td><b>R1</b>\n</td>\n<td>Tidak mampu\n</td>\n<td>Tidak mau\n</td>\n<td>S1 — Telling\n</td>\n</tr>\n\n<tr>\n<td><b>R2</b>\n</td>\n<td>Tidak mampu\n</td>\n<td>Mau\n</td>\n<td>S2 — Selling\n</td>\n</tr>\n\n<tr>\n<td><b>R3</b>\n</td>\n<td>Mampu\n</td>\n<td>Tidak mau\n</td>\n<td>S3 — Participating\n</td>\n</tr>\n\n<tr>\n<td><b>R4</b>\n</td>\n<td>Mampu\n</td>\n<td>Mau\n</td>\n<td>S4 — Delegating\n</td>\n</tr>\n\n</table>\n\n<p>Pemimpin yang efektif menggunakan tingkat perilaku kerja yang tinggi di sejumlah situasi dan hanya sekedarnya di situasi lain — gaya kepemimpinan \"melipat\" mengikuti kesiapan pengikut (R1→S1, R2→S2, R3→S3, R4→S4).\n</p>"
	},
	{
		"label": "Soal 3 — a",
		"q": "<p>Jelaskan karakter wirausaha yang sangat penting dalam mengelola bisnis! Mengapa demikian?\n</p>",
		"a": "<p><b>Karakter</b> adalah tatanan nilai permanen dalam diri seseorang yang ditunjukkan secara konsisten dalam kehidupan sehari-hari — cara berpikir &amp; berperilaku yang menjadi ciri khas (KBBI; Ditjen Mandikdasmen). Karakter wirausaha yang sangat penting dalam mengelola bisnis:\n</p>\n\n<ol>\n\n<li><b>Keberanian mengambil risiko</b> — bisnis selalu mengandung ketidakpastian; tanpa keberanian, peluang takkan pernah dijawab. <i>(Mengapa: peluang usaha hanya untuk yang berani memulai.)</i>\n</li>\n\n<li><b>Pekerja keras</b> — mengelola bisnis menuntut kerja nyata yang konsisten, bukan sekadar rencana di atas kertas.\n</li>\n\n<li><b>Komitmen yang tinggi terhadap pekerjaan</b> — komitmen menjaga konsistensi sampai tujuan tercapai meski rintangan datang.\n</li>\n\n<li><b>Jiwa bertanggung jawab terhadap setiap keputusan</b> — pengelola bisnis harus siap mempertanggungjawabkan setiap akibat dari keputusannya, termasuk kepada karyawan &amp; pelanggan.\n</li>\n\n<li><b>Berpikir kreatif dan inovatif</b> — lingkungan bisnis yang kompleks &amp; dinamis menuntut solusi baru agar tetap kompetitif (tanpa inovasi, bisnis kehilangan daya saing).\n</li>\n\n<li><b>Menyukai tantangan dan selalu berusaha maju</b> — tumbuh di zona perjuangan membuat bisnis terus berkembang.\n</li>\n\n<li><b>Pantang menyerah</b> — \"setiap kegagalan adalah jalan yang lebih dekat ke arah keberhasilan\"; kegagalan adalah bagian dari proses belajar.\n</li>\n\n<li><b>Cepat beradaptasi</b> — sifat lingkungan bisnis yang dinamis menuntut kemampuan menyesuaikan diri dengan cepat.\n</li>\n\n<li><b>Mudah meyakinkan orang</b> — penting untuk menjual gagasan, produk &amp; jasa; membangun jaringan, menarik mitra, pelanggan, dan investor.\n</li>\n\n</ol>\n\n<h4>Mengapa Demikian?\n</h4>\n\n<ul>\n\n<li>Karakter adalah nilai yang <b>permanen &amp; konsisten</b> — bukan sekadar keterampilan teknis yang bisa dipelajari sebentar.\n</li>\n\n<li>Karakter membentuk cara <b>pengambilan keputusan</b>, kualitas hubungan dengan mitra/karyawan/pelanggan, dan <b>kepercayaan</b> — modal mahal dalam bisnis.\n</li>\n\n<li>Dibentuk melalui <b>paradigma yang benar</b> (paradigma diri sendiri, orang lain &amp; kehidupan berbasis nilai-nilai prinsip) dan <b>prinsip melangkah seperti bayi</b> — mempraktikkan nilai setahap demi setahap sampai menjadi kebiasaan dan akhirnya karakter.\n</li>\n\n</ul>"
	},
	{
		"label": "Soal 3 — b",
		"q": "<p>Jelaskan 7 kebiasaan efektif yang dapat menjadi panduan bagi seseorang agar punya karakter pribadi yang kuat!\n</p>",
		"a": "<p>Menurut <b>Stephen R. Covey</b>, 7 kebiasaan efektif yang harus diterapkan dalam kehidupan sehari-hari:\n</p>\n\n<ol>\n\n<li><b>Berpikir Proaktif</b> — setiap peristiwa (baik/buruk) bergantung pada sikap kita terhadapnya. Berpikir proaktif = mengambil tindakan lebih positif dari peristiwa yang tidak menguntungkan; berpikir &amp; berbuat berdasarkan nilai; berpikir sebelum bertindak; menyadari <b>tidak ada yang bisa dikendalikan pada orang lain kecuali mengendalikan diri sendiri</b>. Kelebihan: tidak mudah tersinggung, bertanggung jawab atas pilihan, cepat pulih, fokus pada hal yang bisa diubah. (Lawannya: reaktif — mudah tersinggung, menyalahkan orang lain, banyak mengeluh.)\n</li>\n\n<li><b>Merujuk pada Tujuan Akhir</b> — tahu &amp; paham dari mana berasal, untuk apa ada, kemana menuju. Menyatakan visi &amp; misi kehidupan dengan tegas; cita-cita diwujudkan dengan komitmen kuat. \"Diri sendirilah yang memimpin kehidupan, bukan kehidupan yang memimpin diri sendiri. Hidup merupakan <i>problem of choice</i>.\" Proses penetapan visi-misi: duplikasi, imitasi, personifikasi &amp; identifikasi orang yang diidolakan.\n</li>\n\n<li><b>Dahulukan yang Utama</b> — memilih aktivitas yang berdampak besar di masa depan. Ada 4 kuadran orang: suka menunda (tenang di awal, tertekan saat masalah menumpuk), <i>yes-man</i> (sulit menolak, mengabaikan tugas), pemalas (membuang waktu &amp; uang), dan <b>menentukan prioritas</b> (teliti, penuh perhitungan, mengalokasikan sumber daya dengan matang).\n</li>\n\n<li><b>Berpikir Menang-Menang</b> — membuat kehidupan baik bagi semua orang. 4 cara berpikir: menang-kalah (rakus, menghalalkan segala cara), kalah-menang (tidak percaya diri, tidak mau mencoba), kalah-kalah (\"kalau saya tidak dapat, dia juga tidak boleh dapat\"), dan <b>menang-menang</b>: \"Saya menang, yang lain tidak kalah\", \"menang tanpo ngasorake\" (tanpa mempermalukan lawan), \"nglurug tanpa bala\" (dengan negosiasi &amp; diplomasi).\n</li>\n\n<li><b>Berusahalah Memahami Terlebih Dahulu, Baru Dipahami</b> — manusia fitrahnya ingin diperhatikan. Dengan mendengarkan dulu kita memberi empati &amp; perhatian tulus; orang merasa dihormati &amp; diakui. \"Bagaimana mungkin orang lain mau mendengarkan kita jika kita pun tidak pernah mau mendengarkan orang lain?\" Cara mendengar baik: perhatian melalui <i>body language</i>.\n</li>\n\n<li><b>Wujudkan Sinergi</b> — berbagi <i>resources</i> dengan fokus keunggulan masing-masing; saling menerima &amp; member. Ilustrasi: 4 orang bekerja sendiri = 1+1+1+1 = 4; bersinergi hasilnya = 1111 bahkan 4444. Tidak ada orang sempurna — semua punya keunggulan &amp; kelemahan.\n</li>\n\n<li><b>Asahlah Gergajimu (Renewal)</b> — potensi yang tidak diasah akan terabaikan. \"Batu sungai yang hitam tak bernilai — di tangan pemahat menjadi patung Ganesha yang mahal.\" Mengasah gergaji = mensyukuri karunia dengan mengoptimalkan apapun yang dimiliki. Semakin cepat mulai semakin baik karena umur ada batasnya; gelar/ijazah/status justru bisa menghambat bila menjadi hambatan mental.\n</li>\n\n</ol>\n\n<p>Kebiasaan 1–3 membangun <b>kemenangan pribadi</b>, kebiasaan 4–6 membangun <b>kemenangan bersama</b>, dan kebiasaan 7 adalah <b>pembaruan (renewal)</b> yang menjaga kebugaran seluruh kebiasaan — bersama-sama membentuk karakter pribadi yang kuat.\n</p>"
	},
	{
		"label": "Soal 4 — a",
		"q": "<p>Jelaskan urutan proses untuk mendapatkan gagasan produk untuk berwirausaha!\n</p>",
		"a": "<p>Proses pencarian produk yang layak dijadikan awal gagasan usaha melalui <b>4 tahapan berurutan</b>:\n</p>\n\n<ol>\n\n<li><b>Tahap 1 — Merumuskan Kebutuhan</b>\n<br>\nMenggunakan hirarki kebutuhan menurut <b>A.H. Maslow</b> — setiap tingkat kebutuhan melahirkan jenis usaha yang berbeda:\n\n<ul>\n\n<li><b>Kebutuhan fisiologis</b> — warung makan, toko sembako, kos-kosan.\n</li>\n\n<li><b>Kebutuhan rasa aman &amp; cinta kasih</b> — café, resto, perhotelan.\n</li>\n\n<li><b>Kebutuhan sosial</b> — podcast, EO (event organizer).\n</li>\n\n<li><b>Kebutuhan rasa harga diri</b> — perhiasan, dealer mobil mewah.\n</li>\n\n<li><b>Kebutuhan aktualisasi diri</b> — barang antik, lelang barang mewah.\n</li>\n\n</ul>\n\n</li>\n\n<li><b>Tahap 2 — Menurunkan Kebutuhan menjadi Barang dan Jasa</b>\n<br>\nKebutuhan yang kompleks, bertingkat &amp; unik diturunkan menjadi pilihan barang/jasa yang <b>layak dipasarkan</b>. Syarat utamanya: barang/jasa tersebut harus mempunyai <b>nilai ekonomi</b> — untuk mendapatkannya seseorang harus mengorbankan sejumlah uang. Barang yang belum bernilai ekonomi (udara, sinar matahari, tanah, air sungai) belum bisa menjadi produk usaha.\n</li>\n\n<li><b>Tahap 3 — Mengubah Kebutuhan menjadi Permintaan</b>\n<br>\nProduk bernilai ekonomi diubah menjadi <b>permintaan</b> — sejumlah barang yang dibutuhkan konsumen untuk memenuhi kebutuhan. Permintaan dibedakan menjadi: <b>permintaan potensial</b> (belum dapat diukur kemampuan daya belinya) dan <b>permintaan riil/efektif</b> — permintaan yang diikuti <b>kemampuan membeli (<i>ability to pay</i>) dan kemauan membeli (<i>willing to pay</i>) konsumen.</b>\n</li>\n\n<li><b>Tahap 4 — Mengukur Permintaan Riil ke dalam Rumusan Rencana Penjualan</b>\n<br>\nDilakukan melalui <b>segmentasi pasar</b> — memilih secara spesifik jenis pasar &amp; karakteristik yang dilayani; memilah pasar heterogen menjadi beberapa kelompok pasar homogen (semakin banyak ukuran parameter, semakin spesifik) — dan <b>penempatan produk (positioning)</b>. Hasilnya berupa ukuran permintaan riil yang dirumuskan menjadi rencana penjualan.\n</li>\n\n</ol>"
