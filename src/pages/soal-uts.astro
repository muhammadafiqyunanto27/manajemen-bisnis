---
import Layout from '../layouts/Layout.astro';
import QuizKilat from '../components/QuizKilat.tsx';
import { soalUts } from '../data/soalUts';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const shortOf = (label: string) =>
	label
		.replace(/^Soal\s*/i, '')
		.replace(/\s*\(.*$/, '')
		.replace(/\s*[—–-]\s*/g, '')
		.replace(/\s+/g, '')
		.toLowerCase();
const rows = soalUts.map((s, i) => ({
	n: i + 1,
	short: shortOf(s.label),
	label: s.label,
	qPlain: s.q.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
}));
const quizItems = soalUts.map(({ label, q, a }) => ({ label, q, a }));
---

<Layout
	title="Jawaban Soal UTS — Persiapan UTS Manajemen Bisnis"
	description="Kunci jawaban Soal UTS Manajemen Bisnis —8 soal dijawab lengkap per poin, plus Mode Kilat untuk latihan cepat."
	active="soal-uts"
	crumb="Jawaban Soal UTS · 8 Soal"
	heading="Jawaban Soal UTS"
	subheading="Semua soal UTS beserta jawaban lengkapnya — baca per soal, atau uji ingatanmu lewat Mode Kilat."
>
	<div class="wrap page-body">
		<QuizKilat client:load soal={quizItems} />

		<div class="syl syl--preview">
			<div class="syl-chapter">
				<div class="syl-chead">
					<div class="syl-ctext">
						<h3>Daftar Soal</h3>
						<p>Klik soal untuk membaca jawaban lengkapnya</p>
					</div>
					<span class="syl-count">{soalUts.length} soal</span>
				</div>
				<ul class="syl-topics">
					{
						rows.map((r) => (
							<li>
								<a class="syl-row" href={`${base}/soal-uts/${r.n}`}>
									<span class="syl-n">{r.short}</span>
									<span class="syl-main">
										<b>{r.label}</b>
										<small>{r.qPlain}</small>
									</span>
									<span class="syl-arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</Layout>
