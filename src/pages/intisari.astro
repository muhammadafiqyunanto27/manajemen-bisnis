---
import Layout from '../layouts/Layout.astro';
import { topics, chapters } from '../data/topics';
import { intisari, kutipan } from '../data/intisari';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const poinCount = intisari.reduce((s, t) => s + t.poin.length, 0);
const chapOf = new Map(topics.map((t) => [t.n, t.chapter]));
const bagian = chapters
	.map((c) => {
		const list = intisari.filter((t) => chapOf.get(t.n) === c.n);
		return {
			...c,
			list,
			poin: list.reduce((s, t) => s + t.poin.length, 0),
			istilah: list.reduce((s, t) => s + t.istilah.length, 0),
		};
	})
	.filter((b) => b.list.length > 0);
---

<Layout
	title="Intisari & Hafalan — Persiapan UTS Manajemen Bisnis"
	description="Intisari materi Manajemen Bisnis per bagian: poin hafalan, penjelasan istilah kunci, dan kutipan tokoh."
	active="intisari"
	crumb={`Intisari · ${bagian.length + 1} Halaman`}
	heading="Intisari & Hafalan"
	subheading={`${intisari.length} topik → ${poinCount} poin hafalan + ${kutipan.length} kutipan tokoh. Tiap istilah kunci dijelaskan: apa itu, lalu isinya apa saja.`}
>
	<div class="wrap page-body">
		<p class="note">
			Cara pakai: baca per bagian — tiap topik punya <b>poin ringkas</b> untuk hafalan cepat
			dan <b>istilah kunci</b> yang dijelaskan runut (apa itu → isinya apa saja) biar paham
			bukan cuma hafal. Cari kata tertentu dengan <b>Ctrl + K</b>.
		</p>
		<div class="syl-chapter">
			<ul class="syl-topics syl--preview">
				{
					bagian.map((b) => (
						<li>
							<a class="syl-row" href={`${base}/intisari/${b.n}`}>
								<span class="syl-n">{b.roman}</span>
								<span class="syl-main">
									<b>
										Bagian {b.roman} · {b.title}
									</b>
									<small>
										{b.list.length} topik · {b.poin} poin hafalan · {b.istilah} istilah
										kunci
									</small>
								</span>
								<span class="syl-arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))
				}
				<li>
					<a class="syl-row" href={`${base}/intisari/kutipan`}>
						<span class="syl-n">★</span>
						<span class="syl-main">
							<b>Kutipan Tokoh untuk Dihafal</b>
							<small>
								{kutipan.length} kutipan dari para ahli sepanjang materi — bahasa
								asli + terjemahan
							</small>
						</span>
						<span class="syl-arrow" aria-hidden="true">→</span>
					</a>
				</li>
			</ul>
		</div>
	</div>
</Layout>
