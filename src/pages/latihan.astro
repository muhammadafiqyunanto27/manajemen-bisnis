---
import Layout from '../layouts/Layout.astro';
import QuizKilat from '../components/QuizKilat.tsx';

const latihanSoal = [
	{
		"label": "Soal 1 — a (bobot: pemahaman)",
		"q": "<p>Jelaskan tiga fungsi utama bisnis menurut Steinhoff beserta empat fungsi bisnis secara rinci! Sebutkan pula tiga makna ruang lingkup istilah bisnis!\n</p>",
		"a": "<h4>3 Fungsi Utama — Steinhoff (<i>The World of Business</i>)\n</h4>\n\n<ol>\n\n<li>Mencari bahan baku (<i>acquiring raw material</i>).\n</li>\n\n<li>Mengolah bahan baku menjadi produk jadi (<i>manufacturing raw materials into product</i>).\n</li>\n\n<li>Mendistribusikan produk kepada konsumen (<i>distributing product to consumer</i>).\n</li>\n\n</ol>\n\n<h4>4 Fungsi Rinci\n</h4>\n\n<ol>\n\n<li><b>Fungsi Produksi</b> — menghasilkan barang/jasa yang dibutuhkan masyarakat.\n</li>\n\n<li><b>Fungsi Distribusi</b> — menyalurkan ke lokasi terdekat yang terjangkau konsumen.\n</li>\n\n<li><b>Fungsi Penjualan</b> — menjual barang/jasa yang dihasilkan kepada pengguna/konsumen.\n</li>\n\n<li><b>Fungsi Pemasaran</b> — penyimpanan &amp; pemasaran agar barang berguna bagi konsumen di waktu yang tepat.\n</li>\n\n</ol>\n\n<h4>3 Makna Ruang Lingkup Istilah Bisnis\n</h4>\n\n<ol>\n\n<li><b>Badan usaha</b> — kesatuan yuridis, teknis, ekonomis untuk mencari profit.\n</li>\n\n<li><b>Sektor pasar tertentu</b> — seperti pasar modal.\n</li>\n\n<li><b>Semua aktivitas</b> pada komunitas produsen barang/jasa.\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 1 — b (bobot: pemahaman)",
		"q": "<p>Jelaskan empat karakteristik lingkungan bisnis menurut materi kuliah beserta contohnya masing-masing!\n</p>",
		"a": "<ol>\n\n<li><b>Kompleks</b> — banyak sekali faktor, peristiwa, kondisi &amp; pengaruh dari berbagai sumber sehingga mustahil memahami seluruhnya. Contoh: ponsel mengambil alih bisnis sistem musik yang tak terbayangkan sebelumnya.\n</li>\n\n<li><b>Dinamis</b> — terus berubah seperti lingkungan alam. Contoh: industri film dulu menghasilkan pendapatan dari CD musik, kini dari nada dering.\n</li>\n\n<li><b>Multi-faset</b> — pengamat yang berbeda melihat perubahan secara berbeda (peluang bagi sebagian, ancaman bagi lain). Contoh: TV Plasma/LCD digantikan LED — sebagian produsen melihatnya sebagai peluang untuk memproduksi LED.\n</li>\n\n<li><b>Dampak jangkauan jauh</b> — dampaknya luas bagi organisasi; bisnis yang menyadari dampak lingkungan terus beradaptasi agar selaras dengannya.\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 2 — a (bobot: analisis)",
		"q": "<p>Perencanaan dapat diklasifikasikan berdasarkan sifat penggunaannya. Jelaskan rencana tunggal (sekali pakai) dan rencana standing beserta contohnya masing-masing! Lalu sebutkan empat manfaat perencanaan bagi organisasi!\n</p>",
		"a": "<h4>Berdasarkan Sifat Penggunaan\n</h4>\n\n<ul>\n\n<li><b>Rencana Tunggal (sekali pakai)</b> — direncanakan untuk kegiatan yang tidak berulang; contoh: program, proyek, dan anggaran.\n</li>\n\n<li><b>Rencana Standing (tetap/berulang)</b> — direncanakan untuk kegiatan yang berulang; contoh: kebijakan, prosedur standar, dan aturan.\n</li>\n\n</ul>\n\n<h4>4 Manfaat Perencanaan\n</h4>\n\n<ol>\n\n<li><b>Memberi arah</b> — manajer &amp; karyawan tahu kemana organisasi menuju sehingga kegiatan dapat dikoordinasikan.\n</li>\n\n<li><b>Mengurangi ketidakpastian</b> — mendorong melihat ke depan &amp; mengantisipasi perubahan.\n</li>\n\n<li><b>Mengurangi kegiatan tumpang tindih</b> — inefisiensi menjadi jelas &amp; mudah dikoreksi.\n</li>\n\n<li><b>Menentukan standar untuk pengendalian</b> — kinerja aktual dibandingkan dengan sasaran; penyimpangan diidentifikasi &amp; tindakan koreksi diambil.\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 2 — b (bobot: pemahaman)",
		"q": "<p>Bandingkan struktur organisasi matriks dengan struktur organisasi komite: sebutkan persamaan dan perbedaannya!\n</p>",
		"a": "<h4>Persamaan\n</h4>\n\n<ul>\n\n<li>Sama-sama berbiaya relatif tinggi.\n</li>\n\n<li>Sama-sama dapat menentukan/memindahkan tenaga spesialis secara efisien.\n</li>\n\n<li>Strukturnya tidak sederhana/cenderung rumit.\n</li>\n\n<li>Membutuhkan koordinasi yang baik antarpihak demi tujuan bersama.\n</li>\n\n</ul>\n\n<h4>Perbedaan\n</h4>\n\n<ol>\n\n<li>Pada komite, semua anggota memiliki hak, wewenang &amp; tanggung jawab <b>sama</b>; pada matriks hak &amp; wewenang <b>berbeda</b> sesuai perintah/penunjukan (manajer proyek vs manajer fungsional).\n</li>\n\n<li>Matriks berisiko <b>multi-komando</b> — karyawan melapor kepada dua pimpinan (fungsional &amp; proyek); komite <b>tidak memiliki</b> multi-komando.\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 3 — a (bobot: pemahaman)",
		"q": "<p>Jelaskan Path-Goal Theory (Teori Jalur-Tujuan) menurut House: empat pola perilaku kepemimpinan beserta situasi di mana masing-masing paling efektif!\n</p>",
		"a": "<p><b>Asumsi:</b> perilaku pemimpin dapat menggerakkan bawahan jika menjadi sumber kepuasan bagi mereka; efektivitas = interaksi perilaku pemimpin dengan karakteristik situasi (karakteristik tugas &amp; karakteristik bawahan).\n</p>\n\n<h4>4 Pola Perilaku Kepemimpinan\n</h4>\n\n<ol>\n\n<li><b>Supportive Leadership</b> — perhatian pada kebutuhan &amp; kesejahteraan bawahan, suasana bersahabat. <b>Efektif saat</b> tugas stressful/membosankan (meningkatkan percaya diri &amp; mengurangi ketegangan).\n</li>\n\n<li><b>Directive Leadership</b> — memberitahu harapan, pedoman spesifik, aturan/prosedur, mengatur waktu. <b>Efektif saat</b> tugas terstruktur &amp; kompleks dan bawahan tidak berpengalaman.\n</li>\n\n<li><b>Participative Leadership</b> — berkonsultasi &amp; mempertimbangkan opini bawahan. <b>Efektif saat</b> tugas tidak terstruktur (meningkatkan kejelasan peran).\n</li>\n\n<li><b>Achievement-Oriented Leadership</b> — tujuan menantang, standar tinggi, menunjukkan kepercayaan pada bawahan. <b>Efektif saat</b> tugas tidak terstruktur (meningkatkan percaya diri &amp; harapan menyelesaikan tugas menantang).\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 3 — b (bobot: analisis)",
		"q": "<p>Jelaskan empat kelebihan dan empat kelemahan gaya kepemimpinan otoriter! Dalam situasi apakah gaya ini justru efektif digunakan?\n</p>",
		"a": "<h4>Kelebihan\n</h4>\n\n<ol>\n\n<li>Pengambilan keputusan cepat, terutama situasi stres &amp; berbatas waktu.\n</li>\n\n<li>Rantai komando &amp; pengawasan jelas.\n</li>\n\n<li>Bermanfaat bila bawahan kurang terampil — pemimpin dapat melatih &amp; mengatur staf.\n</li>\n\n<li>Hasil lebih konsisten &amp; terukur (tugas, target, tenggat jelas).\n</li>\n\n</ol>\n\n<h4>Kelemahan\n</h4>\n\n<ol>\n\n<li>Memunculkan resistensi/kebencian anggota.\n</li>\n\n<li>Tekanan tinggi pada bawahan → frustrasi &amp; semangat menurun.\n</li>\n\n<li>Keterampilan pemecahan masalah kreatif rendah (bawahan tak bisa menyumbang ide).\n</li>\n\n<li>Kesuksesan bergantung pada kemampuan pemimpin.\n</li>\n\n<li>Turnover tinggi.\n</li>\n\n</ol>\n\n<h4>Kapan Gaya Otoriter Efektif Digunakan\n</h4>\n\n<ol>\n\n<li>Organisasi mengalami perubahan signifikan/ketidakpastian.\n</li>\n\n<li>Membutuhkan keputusan cepat &amp; akurat (konstruksi, manufaktur).\n</li>\n\n<li>Tidak mentoleransi kesalahan (kontrol kualitas ketat, rumah sakit — kesalahan bisa berakibat fatal).\n</li>\n\n<li>Lingkungan tekanan tinggi atau darurat (konflik/perang).\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 4 — a (bobot: pemahaman)",
		"q": "<p>Jelaskan karakteristik tipe kepribadian High-C (Compliant) menurut DISC: kekuatan, cara mengatur, dan area yang perlu diperbaiki!\n</p>",
		"a": "<h4>Karakteristik High-C (Compliant)\n</h4>\n\n<ul>\n\n<li>Mengumpulkan data, fakta &amp; gambar.\n</li>\n\n<li>Melakukan segalanya sangat baik bahkan sempurna — memiliki standar sendiri yang jauh lebih tinggi dari orang lain.\n</li>\n\n<li>Pendiam/tertutup &amp; berorientasi tugas; tidak suka didorong/dipaksa.\n</li>\n\n<li>Merencanakan segalanya sebelum bertindak — hampir tidak pernah buru-buru tanpa mempertimbangkan semua fakta &amp; grafik.\n</li>\n\n</ul>\n\n<h4>Cara Mengatur Mereka\n</h4>\n\n<ul>\n\n<li>Beri <b>data sebanyak mungkin</b> (grafik, tabel, form tertulis/essay) — mereka hanya menginginkan data.\n</li>\n\n<li>Justifikasi dengan logika — tidak peduli Anda teman baiknya.\n</li>\n\n<li>Beri waktu untuk mengambil keputusan.\n</li>\n\n<li>Jika menawarkan cara baru, tunjukkan bahwa itu meningkatkan <b>standar atau efisiensi</b> mereka.\n</li>\n\n</ul>\n\n<h4>Area yang Perlu Diperbaiki\n</h4>\n\n<ul>\n\n<li>Berjuang menjadi <b>excellence, bukan perfection</b>.\n</li>\n\n<li>Minta opini orang lain &amp; menerima standar \"cukup baik\".\n</li>\n\n<li>Lebih cepat mengambil keputusan.\n</li>\n\n<li>Melakukan sesuatu yang baru &amp; spontan.\n</li>\n\n<li>Lebih terbuka menyatakan perasaan; lebih banyak bergaul dengan orang.\n</li>\n\n</ul>"
	},
	{
		"label": "Soal 4 — b (bobot: analisis)",
		"q": "<p>Dalam LPC Contingency Model Fiedler, sebutkan tiga faktor situasi yang menentukan efektivitas pemimpin! Jelaskan pula perbedaan pemimpin LPC tinggi dan LPC rendah!\n</p>",
		"a": "<h4>3 Faktor Situasi\n</h4>\n\n<ol>\n\n<li><b>Hubungan pemimpin–bawahan</b> (<i>leader-member relations</i>) — baik/buruk.\n</li>\n\n<li><b>Struktur tugas</b> (<i>task structure</i>) — terstruktur/tidak terstruktur.\n</li>\n\n<li><b>Kekuatan posisi</b> (<i>position power</i>) — kuat/lemah.\n</li>\n\n</ol>\n\n<h4>Perbedaan Pemimpin LPC Tinggi vs LPC Rendah\n</h4>\n\n<p>Efektivitas kepemimpinan diukur dengan skor <b>Least Preferred Coworker (LPC)</b> — rekan kerja yang paling tidak disukai:\n</p>\n\n<ul>\n\n<li><b>Pemimpin LPC tinggi</b> — hubungan dekat dengan bawahan (berorientasi hubungan/orang).\n</li>\n\n<li><b>Pemimpin LPC rendah</b> — cenderung berorientasi pada pencapaian sasaran tugas.\n</li>\n\n</ul>\n\n<p>Kontribusi pemimpin terhadap efektivitas kelompok tergantung pada kecocokan antara gaya kepemimpinan dengan kesesuaian situasi:\n</p>\n\n<ul>\n\n<li>Situasi sangat menguntungkan (hubungan baik, tugas terstruktur, posisi kuat) → <b>LPC rendah</b> efektif.\n</li>\n\n<li>Situasi sedang menguntungkan → <b>LPC tinggi</b> efektif.\n</li>\n\n<li>Situasi paling tidak menguntungkan → kembali <b>LPC rendah</b>.\n</li>\n\n</ul>"
	},
	{
		"label": "Soal 5 — a (bobot: pemahaman)",
		"q": "<p>Jelaskan tiga paradigma pembentuk karakter menurut materi Karakter Wirausaha, beserta panduan yang benar untuk masing-masing paradigma!\n</p>",
		"a": "<p><b>Paradigma</b> (Sean Covey) = cara kita memandang sesuatu — pandangan/kerangka acuan/keyakinan kita. Tiga paradigma pembentuk karakter:\n</p>\n\n<ol>\n\n<li><b>Paradigma terhadap diri sendiri</b> — bagaimana &amp; ke mana seseorang tergantung persepsinya pada dirinya sendiri. <b>Panduan:</b> bersyukur atas eksistensi, <i>positive thinking</i>, yakin setiap orang mampu berubah &amp; merubah nasib, berani mencoba berkali-kali.\n</li>\n\n<li><b>Paradigma terhadap orang lain</b> — kesalahan menilai orang terjadi karena informasi tidak lengkap. <b>Panduan:</b> selalu berprasangka baik &amp; melakukan klarifikasi.\n</li>\n\n<li><b>Paradigma kehidupan</b> — berpegang pada nilai-nilai prinsip (kebenaran universal: jujur, kerja keras, bertanggung jawab, adil, disiplin). <b>Panduan:</b> nilai prinsip dipraktikkan setahap demi setahap (\"prinsip melangkah seperti bayi\") sampai menjadi kebiasaan lalu karakter — karena setiap nilai prinsip \"selalu berkata benar\" (mis. kejujuran berbuah kepercayaan).\n</li>\n\n</ol>"
	},
	{
		"label": "Soal 5 — b (bobot: analisis)",
		"q": "<p>Jelaskan perbedaan permintaan potensial dan permintaan riil! Mengapa tahap ini penting sebelum merumuskan rencana penjualan?\n</p>",
		"a": "<p><b>Permintaan</b> adalah sejumlah barang yang dibutuhkan konsumen untuk memenuhi kebutuhannya.\n</p>\n\n<ul>\n\n<li><b>Permintaan potensial</b> — permintaan yang belum dapat diukur seberapa kemampuan daya belinya (hanya sebatas keinginan/kebutuhan).\n</li>\n\n<li><b>Permintaan riil/efektif</b> — permintaan yang diikuti <b>kemampuan membeli (<i>ability to pay</i>) dan kemauan membeli (<i>willing to pay</i>) konsumen.</b>\n</li>\n\n</ul>\n\n<h4>Mengapa Tahap Ini Penting Sebelum Merumuskan Rencana Penjualan\n</h4>\n\n<p>Rencana penjualan hanya bisa disusun dari angka yang realistis. Jika sebuah usaha merencanakan penjualan berdasarkan permintaan potensial (tanpa daya beli &amp; kemauan membayar yang terukur), target penjualan akan melampaui permintaan efektif sehingga rencana gagal. Tahap ini — mengukur permintaan riil → segmentasi pasar &amp; positioning → rumusan rencana penjualan — menjembatani produk bernilai ekonomi menjadi angka penjualan yang dapat dipertanggungjawabkan.\n</p>"
	},
	{
		"label": "Soal 6 — a (bobot: pemahaman)",
		"q": "<p>Sebutkan sembilan blok komponen Business Model Canvas (BMC) dan jelaskan singkat blok Value Proposition beserta manfaatnya bagi bisnis!\n</p>",
		"a": "<h4>9 Blok BMC (Osterwalder, 2012)\n</h4>\n\n<ol>\n\n<li>Value Proposition\n</li>\n\n<li>Customer Segmen\n</li>\n\n<li>Customer Relationship\n</li>\n\n<li>Channel\n</li>\n\n<li>Key Activities\n</li>\n\n<li>Key Resources\n</li>\n\n<li>Key Partners\n</li>\n\n<li>Cost Structure\n</li>\n\n<li>Revenue Streams\n</li>\n\n</ol>\n\n<p>Didahului oleh <b>Noble Purpose</b> — pernyataan visi &amp; misi agar usaha bermanfaat bagi masyarakat, bukan sekadar keuntungan.\n</p>\n\n<h4>Blok Value Proposition\n</h4>\n\n<p>= nilai jual produk/jasa sehingga konsumen memilih perusahaan Anda daripada kompetitor; memastikan bisnis menjual solusi atas masalah yang benar-benar dihadapi konsumen.\n</p>\n\n<p><b>Pertanyaan pemandu:</b>\n</p>\n\n<ul>\n\n<li>Apa penyebab masalah itu terjadi?\n</li>\n\n<li>Mengapa konsumen ingin masalah hilang?\n</li>\n\n<li>Apa manfaat bisnis untuk konsumen?\n</li>\n\n</ul>\n\n<p><b>Manfaatnya:</b> membaca perilaku konsumen lebih akurat, memvisualisasi nilai bisnis, dan menghasilkan produk sesuai ekspektasi pasar sehingga produk lebih mudah diterima &amp; bisnis tumbuh.\n</p>"
	},
	{
		"label": "Soal 6 — b (bobot: analisis)",
		"q": "<p>Seorang wirausaha hanya mengandalkan satu jenis produk untuk satu segmen pelanggan. Berdasarkan materi Masalah dan Hambatan Bisnis, masalah apa yang dihadapinya dan bagaimana solusinya? Jelaskan!\n</p>",
		"a": "<h4>Masalah\n</h4>\n\n<p>Ketergantungan pada <b>satu sumber pendapatan</b> — bisnis yang hanya mengandalkan satu sumber pendapatan akan kesulitan jika sumber tersebut terganggu: selera pelanggan berubah, pemasok bermasalah, atau segmen pasar menyusut — maka seluruh pendapatan ikut terhenti sekaligus.\n</p>\n\n<h4>Solusi\n</h4>\n\n<ol>\n\n<li><b>Diversifikasi produk atau layanan</b> untuk menciptakan lebih banyak aliran pendapatan (<i>multiple revenue streams</i> — sesuai blok Revenue Streams pada BMC).\n</li>\n\n<li><b>Jajaki pasar baru atau segmen pelanggan yang berbeda</b> (sesuai blok Customer Segmen).\n</li>\n\n</ol>\n\n<p>Selain itu disarankan membuat rencana keuangan yang fleksibel &amp; terus memantau kondisi pasar — prinsip adaptasi: mengubah hambatan menjadi peluang pertumbuhan melalui kemampuan beradaptasi, berinovasi &amp; terus belajar.\n</p>"
	}
];
---

<Layout
	title="Latihan Soal — Persiapan UTS Manajemen Bisnis"
	heading="Latihan Soal"
	subheading="12 soal essai (6 bagian a & b) — bobot & format menyerupai soal UTS, lengkap dengan kunci jawaban"
>
	<section class="topic">
		<div class="wrap">
			<QuizKilat client:load soal={latihanSoal} />
			<hr class="divider" />
<div class="sec-title"><span class="num">📝</span><h2>Latihan Soal — Format Serip</h2></div>
<p class="sec-sub">12 soal essai (6 bagian a &amp; b) — bobot &amp; format menyerupai soal UTS di atas, lengkap dengan kunci jawaban</p>

<div class="card accent-sky">
<h3>Paket 1 — Bisnis &amp; Lingkungan Bisnis</h3>
<div class="qbox"><div class="label">Soal 1 — a (bobot: pemahaman)</div>
<p>Jelaskan tiga fungsi utama bisnis menurut Steinhoff beserta empat fungsi bisnis secara rinci! Sebutkan pula tiga makna ruang lingkup istilah bisnis!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>3 Fungsi Utama — Steinhoff (<i>The World of Business</i>)</h4>
<ol>
<li>Mencari bahan baku (<i>acquiring raw material</i>).</li>
<li>Mengolah bahan baku menjadi produk jadi (<i>manufacturing raw materials into product</i>).</li>
<li>Mendistribusikan produk kepada konsumen (<i>distributing product to consumer</i>).</li>
</ol>
<h4>4 Fungsi Rinci</h4>
<ol>
<li><b>Fungsi Produksi</b> — menghasilkan barang/jasa yang dibutuhkan masyarakat.</li>
<li><b>Fungsi Distribusi</b> — menyalurkan ke lokasi terdekat yang terjangkau konsumen.</li>
<li><b>Fungsi Penjualan</b> — menjual barang/jasa yang dihasilkan kepada pengguna/konsumen.</li>
<li><b>Fungsi Pemasaran</b> — penyimpanan &amp; pemasaran agar barang berguna bagi konsumen di waktu yang tepat.</li>
</ol>
<h4>3 Makna Ruang Lingkup Istilah Bisnis</h4>
<ol>
<li><b>Badan usaha</b> — kesatuan yuridis, teknis, ekonomis untuk mencari profit.</li>
<li><b>Sektor pasar tertentu</b> — seperti pasar modal.</li>
<li><b>Semua aktivitas</b> pada komunitas produsen barang/jasa.</li>
</ol>
</div>
<div class="qbox"><div class="label">Soal 1 — b (bobot: pemahaman)</div>
<p>Jelaskan empat karakteristik lingkungan bisnis menurut materi kuliah beserta contohnya masing-masing!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<ol>
<li><b>Kompleks</b> — banyak sekali faktor, peristiwa, kondisi &amp; pengaruh dari berbagai sumber sehingga mustahil memahami seluruhnya. Contoh: ponsel mengambil alih bisnis sistem musik yang tak terbayangkan sebelumnya.</li>
<li><b>Dinamis</b> — terus berubah seperti lingkungan alam. Contoh: industri film dulu menghasilkan pendapatan dari CD musik, kini dari nada dering.</li>
<li><b>Multi-faset</b> — pengamat yang berbeda melihat perubahan secara berbeda (peluang bagi sebagian, ancaman bagi lain). Contoh: TV Plasma/LCD digantikan LED — sebagian produsen melihatnya sebagai peluang untuk memproduksi LED.</li>
<li><b>Dampak jangkauan jauh</b> — dampaknya luas bagi organisasi; bisnis yang menyadari dampak lingkungan terus beradaptasi agar selaras dengannya.</li>
</ol>
</div>
</div>

<div class="card accent-amber">
<h3>Paket 2 — Perencanaan &amp; Pengorganisasian</h3>
<div class="qbox"><div class="label">Soal 2 — a (bobot: analisis)</div>
<p>Perencanaan dapat diklasifikasikan berdasarkan sifat penggunaannya. Jelaskan rencana tunggal (sekali pakai) dan rencana standing beserta contohnya masing-masing! Lalu sebutkan empat manfaat perencanaan bagi organisasi!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>Berdasarkan Sifat Penggunaan</h4>
<ul>
<li><b>Rencana Tunggal (sekali pakai)</b> — direncanakan untuk kegiatan yang tidak berulang; contoh: program, proyek, dan anggaran.</li>
<li><b>Rencana Standing (tetap/berulang)</b> — direncanakan untuk kegiatan yang berulang; contoh: kebijakan, prosedur standar, dan aturan.</li>
</ul>
<h4>4 Manfaat Perencanaan</h4>
<ol>
<li><b>Memberi arah</b> — manajer &amp; karyawan tahu kemana organisasi menuju sehingga kegiatan dapat dikoordinasikan.</li>
<li><b>Mengurangi ketidakpastian</b> — mendorong melihat ke depan &amp; mengantisipasi perubahan.</li>
<li><b>Mengurangi kegiatan tumpang tindih</b> — inefisiensi menjadi jelas &amp; mudah dikoreksi.</li>
<li><b>Menentukan standar untuk pengendalian</b> — kinerja aktual dibandingkan dengan sasaran; penyimpangan diidentifikasi &amp; tindakan koreksi diambil.</li>
</ol>
</div>
<div class="qbox"><div class="label">Soal 2 — b (bobot: pemahaman)</div>
<p>Bandingkan struktur organisasi matriks dengan struktur organisasi komite: sebutkan persamaan dan perbedaannya!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>Persamaan</h4>
<ul>
<li>Sama-sama berbiaya relatif tinggi.</li>
<li>Sama-sama dapat menentukan/memindahkan tenaga spesialis secara efisien.</li>
<li>Strukturnya tidak sederhana/cenderung rumit.</li>
<li>Membutuhkan koordinasi yang baik antarpihak demi tujuan bersama.</li>
</ul>
<h4>Perbedaan</h4>
<ol>
<li>Pada komite, semua anggota memiliki hak, wewenang &amp; tanggung jawab <b>sama</b>; pada matriks hak &amp; wewenang <b>berbeda</b> sesuai perintah/penunjukan (manajer proyek vs manajer fungsional).</li>
<li>Matriks berisiko <b>multi-komando</b> — karyawan melapor kepada dua pimpinan (fungsional &amp; proyek); komite <b>tidak memiliki</b> multi-komando.</li>
</ol>
</div>
</div>

<div class="card accent-emerald">
<h3>Paket 3 — Kepemimpinan</h3>
<div class="qbox"><div class="label">Soal 3 — a (bobot: pemahaman)</div>
<p>Jelaskan Path-Goal Theory (Teori Jalur-Tujuan) menurut House: empat pola perilaku kepemimpinan beserta situasi di mana masing-masing paling efektif!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<p><b>Asumsi:</b> perilaku pemimpin dapat menggerakkan bawahan jika menjadi sumber kepuasan bagi mereka; efektivitas = interaksi perilaku pemimpin dengan karakteristik situasi (karakteristik tugas &amp; karakteristik bawahan).</p>
<h4>4 Pola Perilaku Kepemimpinan</h4>
<ol>
<li><b>Supportive Leadership</b> — perhatian pada kebutuhan &amp; kesejahteraan bawahan, suasana bersahabat. <b>Efektif saat</b> tugas stressful/membosankan (meningkatkan percaya diri &amp; mengurangi ketegangan).</li>
<li><b>Directive Leadership</b> — memberitahu harapan, pedoman spesifik, aturan/prosedur, mengatur waktu. <b>Efektif saat</b> tugas terstruktur &amp; kompleks dan bawahan tidak berpengalaman.</li>
<li><b>Participative Leadership</b> — berkonsultasi &amp; mempertimbangkan opini bawahan. <b>Efektif saat</b> tugas tidak terstruktur (meningkatkan kejelasan peran).</li>
<li><b>Achievement-Oriented Leadership</b> — tujuan menantang, standar tinggi, menunjukkan kepercayaan pada bawahan. <b>Efektif saat</b> tugas tidak terstruktur (meningkatkan percaya diri &amp; harapan menyelesaikan tugas menantang).</li>
</ol>
</div>
<div class="qbox"><div class="label">Soal 3 — b (bobot: analisis)</div>
<p>Jelaskan empat kelebihan dan empat kelemahan gaya kepemimpinan otoriter! Dalam situasi apakah gaya ini justru efektif digunakan?</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>Kelebihan</h4>
<ol>
<li>Pengambilan keputusan cepat, terutama situasi stres &amp; berbatas waktu.</li>
<li>Rantai komando &amp; pengawasan jelas.</li>
<li>Bermanfaat bila bawahan kurang terampil — pemimpin dapat melatih &amp; mengatur staf.</li>
<li>Hasil lebih konsisten &amp; terukur (tugas, target, tenggat jelas).</li>
</ol>
<h4>Kelemahan</h4>
<ol>
<li>Memunculkan resistensi/kebencian anggota.</li>
<li>Tekanan tinggi pada bawahan → frustrasi &amp; semangat menurun.</li>
<li>Keterampilan pemecahan masalah kreatif rendah (bawahan tak bisa menyumbang ide).</li>
<li>Kesuksesan bergantung pada kemampuan pemimpin.</li>
<li>Turnover tinggi.</li>
</ol>
<h4>Kapan Gaya Otoriter Efektif Digunakan</h4>
<ol>
<li>Organisasi mengalami perubahan signifikan/ketidakpastian.</li>
<li>Membutuhkan keputusan cepat &amp; akurat (konstruksi, manufaktur).</li>
<li>Tidak mentoleransi kesalahan (kontrol kualitas ketat, rumah sakit — kesalahan bisa berakibat fatal).</li>
<li>Lingkungan tekanan tinggi atau darurat (konflik/perang).</li>
</ol>
</div>
</div>

<div class="card accent-violet">
<h3>Paket 4 — DISC &amp; Kontingensi</h3>
<div class="qbox"><div class="label">Soal 4 — a (bobot: pemahaman)</div>
<p>Jelaskan karakteristik tipe kepribadian High-C (Compliant) menurut DISC: kekuatan, cara mengatur, dan area yang perlu diperbaiki!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>Karakteristik High-C (Compliant)</h4>
<ul>
<li>Mengumpulkan data, fakta &amp; gambar.</li>
<li>Melakukan segalanya sangat baik bahkan sempurna — memiliki standar sendiri yang jauh lebih tinggi dari orang lain.</li>
<li>Pendiam/tertutup &amp; berorientasi tugas; tidak suka didorong/dipaksa.</li>
<li>Merencanakan segalanya sebelum bertindak — hampir tidak pernah buru-buru tanpa mempertimbangkan semua fakta &amp; grafik.</li>
</ul>
<h4>Cara Mengatur Mereka</h4>
<ul>
<li>Beri <b>data sebanyak mungkin</b> (grafik, tabel, form tertulis/essay) — mereka hanya menginginkan data.</li>
<li>Justifikasi dengan logika — tidak peduli Anda teman baiknya.</li>
<li>Beri waktu untuk mengambil keputusan.</li>
<li>Jika menawarkan cara baru, tunjukkan bahwa itu meningkatkan <b>standar atau efisiensi</b> mereka.</li>
</ul>
<h4>Area yang Perlu Diperbaiki</h4>
<ul>
<li>Berjuang menjadi <b>excellence, bukan perfection</b>.</li>
<li>Minta opini orang lain &amp; menerima standar "cukup baik".</li>
<li>Lebih cepat mengambil keputusan.</li>
<li>Melakukan sesuatu yang baru &amp; spontan.</li>
<li>Lebih terbuka menyatakan perasaan; lebih banyak bergaul dengan orang.</li>
</ul>
</div>
<div class="qbox"><div class="label">Soal 4 — b (bobot: analisis)</div>
<p>Dalam LPC Contingency Model Fiedler, sebutkan tiga faktor situasi yang menentukan efektivitas pemimpin! Jelaskan pula perbedaan pemimpin LPC tinggi dan LPC rendah!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>3 Faktor Situasi</h4>
<ol>
<li><b>Hubungan pemimpin–bawahan</b> (<i>leader-member relations</i>) — baik/buruk.</li>
<li><b>Struktur tugas</b> (<i>task structure</i>) — terstruktur/tidak terstruktur.</li>
<li><b>Kekuatan posisi</b> (<i>position power</i>) — kuat/lemah.</li>
</ol>
<h4>Perbedaan Pemimpin LPC Tinggi vs LPC Rendah</h4>
<p>Efektivitas kepemimpinan diukur dengan skor <b>Least Preferred Coworker (LPC)</b> — rekan kerja yang paling tidak disukai:</p>
<ul>
<li><b>Pemimpin LPC tinggi</b> — hubungan dekat dengan bawahan (berorientasi hubungan/orang).</li>
<li><b>Pemimpin LPC rendah</b> — cenderung berorientasi pada pencapaian sasaran tugas.</li>
</ul>
<p>Kontribusi pemimpin terhadap efektivitas kelompok tergantung pada kecocokan antara gaya kepemimpinan dengan kesesuaian situasi:</p>
<ul>
<li>Situasi sangat menguntungkan (hubungan baik, tugas terstruktur, posisi kuat) → <b>LPC rendah</b> efektif.</li>
<li>Situasi sedang menguntungkan → <b>LPC tinggi</b> efektif.</li>
<li>Situasi paling tidak menguntungkan → kembali <b>LPC rendah</b>.</li>
</ul>
</div>
</div>

<div class="card accent-orange">
<h3>Paket 5 — Wirausaha &amp; Gagasan Usaha</h3>
<div class="qbox"><div class="label">Soal 5 — a (bobot: pemahaman)</div>
<p>Jelaskan tiga paradigma pembentuk karakter menurut materi Karakter Wirausaha, beserta panduan yang benar untuk masing-masing paradigma!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<p><b>Paradigma</b> (Sean Covey) = cara kita memandang sesuatu — pandangan/kerangka acuan/keyakinan kita. Tiga paradigma pembentuk karakter:</p>
<ol>
<li><b>Paradigma terhadap diri sendiri</b> — bagaimana &amp; ke mana seseorang tergantung persepsinya pada dirinya sendiri. <b>Panduan:</b> bersyukur atas eksistensi, <i>positive thinking</i>, yakin setiap orang mampu berubah &amp; merubah nasib, berani mencoba berkali-kali.</li>
<li><b>Paradigma terhadap orang lain</b> — kesalahan menilai orang terjadi karena informasi tidak lengkap. <b>Panduan:</b> selalu berprasangka baik &amp; melakukan klarifikasi.</li>
<li><b>Paradigma kehidupan</b> — berpegang pada nilai-nilai prinsip (kebenaran universal: jujur, kerja keras, bertanggung jawab, adil, disiplin). <b>Panduan:</b> nilai prinsip dipraktikkan setahap demi setahap ("prinsip melangkah seperti bayi") sampai menjadi kebiasaan lalu karakter — karena setiap nilai prinsip "selalu berkata benar" (mis. kejujuran berbuah kepercayaan).</li>
</ol>
</div>
<div class="qbox"><div class="label">Soal 5 — b (bobot: analisis)</div>
<p>Jelaskan perbedaan permintaan potensial dan permintaan riil! Mengapa tahap ini penting sebelum merumuskan rencana penjualan?</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<p><b>Permintaan</b> adalah sejumlah barang yang dibutuhkan konsumen untuk memenuhi kebutuhannya.</p>
<ul>
<li><b>Permintaan potensial</b> — permintaan yang belum dapat diukur seberapa kemampuan daya belinya (hanya sebatas keinginan/kebutuhan).</li>
<li><b>Permintaan riil/efektif</b> — permintaan yang diikuti <b>kemampuan membeli (<i>ability to pay</i>) dan kemauan membeli (<i>willing to pay</i>) konsumen.</b></li>
</ul>
<h4>Mengapa Tahap Ini Penting Sebelum Merumuskan Rencana Penjualan</h4>
<p>Rencana penjualan hanya bisa disusun dari angka yang realistis. Jika sebuah usaha merencanakan penjualan berdasarkan permintaan potensial (tanpa daya beli &amp; kemauan membayar yang terukur), target penjualan akan melampaui permintaan efektif sehingga rencana gagal. Tahap ini — mengukur permintaan riil → segmentasi pasar &amp; positioning → rumusan rencana penjualan — menjembatani produk bernilai ekonomi menjadi angka penjualan yang dapat dipertanggungjawabkan.</p>
</div>
</div>

<div class="card accent-rose">
<h3>Paket 6 — ATM, BMC &amp; Hambatan Bisnis</h3>
<div class="qbox"><div class="label">Soal 6 — a (bobot: pemahaman)</div>
<p>Sebutkan sembilan blok komponen Business Model Canvas (BMC) dan jelaskan singkat blok Value Proposition beserta manfaatnya bagi bisnis!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>9 Blok BMC (Osterwalder, 2012)</h4>
<ol>
<li>Value Proposition</li>
<li>Customer Segmen</li>
<li>Customer Relationship</li>
<li>Channel</li>
<li>Key Activities</li>
<li>Key Resources</li>
<li>Key Partners</li>
<li>Cost Structure</li>
<li>Revenue Streams</li>
</ol>
<p>Didahului oleh <b>Noble Purpose</b> — pernyataan visi &amp; misi agar usaha bermanfaat bagi masyarakat, bukan sekadar keuntungan.</p>
<h4>Blok Value Proposition</h4>
<p>= nilai jual produk/jasa sehingga konsumen memilih perusahaan Anda daripada kompetitor; memastikan bisnis menjual solusi atas masalah yang benar-benar dihadapi konsumen.</p>
<p><b>Pertanyaan pemandu:</b></p>
<ul>
<li>Apa penyebab masalah itu terjadi?</li>
<li>Mengapa konsumen ingin masalah hilang?</li>
<li>Apa manfaat bisnis untuk konsumen?</li>
</ul>
<p><b>Manfaatnya:</b> membaca perilaku konsumen lebih akurat, memvisualisasi nilai bisnis, dan menghasilkan produk sesuai ekspektasi pasar sehingga produk lebih mudah diterima &amp; bisnis tumbuh.</p>
</div>
<div class="qbox"><div class="label">Soal 6 — b (bobot: analisis)</div>
<p>Seorang wirausaha hanya mengandalkan satu jenis produk untuk satu segmen pelanggan. Berdasarkan materi Masalah dan Hambatan Bisnis, masalah apa yang dihadapinya dan bagaimana solusinya? Jelaskan!</p></div>
<div class="answer"><div class="label">Kunci Jawaban</div>
<h4>Masalah</h4>
<p>Ketergantungan pada <b>satu sumber pendapatan</b> — bisnis yang hanya mengandalkan satu sumber pendapatan akan kesulitan jika sumber tersebut terganggu: selera pelanggan berubah, pemasok bermasalah, atau segmen pasar menyusut — maka seluruh pendapatan ikut terhenti sekaligus.</p>
<h4>Solusi</h4>
<ol>
<li><b>Diversifikasi produk atau layanan</b> untuk menciptakan lebih banyak aliran pendapatan (<i>multiple revenue streams</i> — sesuai blok Revenue Streams pada BMC).</li>
<li><b>Jajaki pasar baru atau segmen pelanggan yang berbeda</b> (sesuai blok Customer Segmen).</li>
</ol>
<p>Selain itu disarankan membuat rencana keuangan yang fleksibel &amp; terus memantau kondisi pasar — prinsip adaptasi: mengubah hambatan menjadi peluang pertumbuhan melalui kemampuan beradaptasi, berinovasi &amp; terus belajar.</p>
</div>
</div>

