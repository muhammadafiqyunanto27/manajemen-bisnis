---
import Layout from '../layouts/Layout.astro';
import QuizKilat from '../components/QuizKilat.tsx';
import { latihanSoal } from '../data/latihanSoal';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const shortOf = (label: string) =>
	label
		.replace(/^Soal\s*/i, '')
		.replace(/\s*\(.*$/, '')
		.replace(/\s*[—–-]\s*/g, '')
		.replace(/\s+/g, '')
		.toLowerCase();

const paketNos = [...new Set(latihanSoal.map((s) => s.paket))].sort((a, b) => a - b);
const pakets = paketNos.map((p) => {
	const list = latihanSoal.filter((s) => s.paket === p);
	const first = list[0];
	return {
		paket: p,
		title: first.paketTitle,
		rows: list.map((s) => ({
			n: latihanSoal.indexOf(s) + 1,
			short: shortOf(s.label),
			label: s.label,
			qPlain: s.q.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
		})),
	};
});
const quizItems = latihanSoal.map(({ label, q, a }) => ({ label, q, a }));
---

<Layout
	title="Latihan Soal — Persiapan UTS Manajemen Bisnis"
	description="Latihan Soal Manajemen Bisnis —12 soal dalam6 paket lengkap dengan kunci jawaban, plus Mode Kilat."
	active="latihan"
	crumb={`Latihan Soal · ${pakets.length} Paket · ${latihanSoal.length} Soal`}
	heading="Latihan Soal"
	subheading={`${latihanSoal.length} soal dalam ${pakets.length} paket — kerjakan dulu di kertas, lalu cocokkan kunci jawabannya.`}
>
	<div class="wrap page-body">
		<QuizKilat client:load soal={quizItems} />

		<div class="syl syl--preview">
			{
				pakets.map((p) => (
					<div class="syl-chapter">
						<div class="syl-chead">
							<span class="syl-roman">{p.paket}</span>
							<div class="syl-ctext">
								<h3>{p.title}</h3>
								<p>Klik soal untuk membaca kunci jawaban lengkapnya</p>
							</div>
							<span class="syl-count">{p.rows.length} soal</span>
						</div>
						<ul class="syl-topics">
							{p.rows.map((r) => (
								<li>
									<a class="syl-row" href={`${base}/latihan/${r.n}`}>
										<span class="syl-n">{r.short}</span>
										<span class="syl-main">
											<b>{r.label}</b>
											<small>{r.qPlain}</small>
										</span>
										<span class="syl-arrow" aria-hidden="true">→</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="card" style="margin-top:24px">
			<h3><span class="tag">Tips</span> Cara Pakai Latihan Ini</h3>
			<ul>
				<li>Kerjakan soal sendiri dulu di kertas — jangan langsung buka jawabannya.</li>
				<li>Gunakan <b>Mode Kilat</b> di atas untuk latihan acak: kunci jawaban baru muncul setelah kamu menekan tombolnya.</li>
				<li>Setelah selesai, hitung skormu dan ulangi sampai semua soal hafal.</li>
				<li>Ada istilah yang lupa? Buka bagian <b>Rangkuman</b> atau pakai tombol <b>Cari</b> (Ctrl + K).</li>
			</ul>
		</div>
	</div>
</Layout>
