---
import '../styles/global.css';
import SearchOverlay from '../components/SearchOverlay.astro';
import { chapters, topics } from '../data/topics';

interface Props {
	title: string;
	description?: string;
	heading?: string;
	subheading?: string;
	crumb?: string;
	active?: 'home' | 'rangkuman' | 'soal-uts' | 'latihan';
}

const {
	title,
	description = 'Persiapan UTS Manajemen Bisnis — rangkuman 19 file materi kuliah, quote tokoh, jawaban soal UTS, dan latihan soal.',
	heading,
	subheading,
	crumb,
	active,
} = Astro.props;

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const home = base === '' ? '/' : base;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light dark" />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📚</text></svg>"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
		/>
		<title>{title}</title>
		<script is:inline>
			// Terapkan tema sebelum paint pertama (hindari kedip)
			(() => {
				try {
					const saved = localStorage.getItem('theme');
					if (saved === 'dark' || saved === 'light') {
						document.documentElement.setAttribute('data-theme', saved);
					}
				} catch {}
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#konten">Lompat ke konten</a>

		<nav class="topbar" aria-label="Navigasi utama">
			<div class="wrap topbar-inner">
				<button
					type="button"
					class="burger"
					id="burger"
					aria-label="Buka daftar isi"
					aria-expanded="false"
					aria-controls="drawer"
				>
					<span></span><span></span><span></span>
				</button>
				<a href={home} class="brand">Manajemen Bisnis</a>
				<div class="topbar-end">
					<div class="main-links">
						<a href={home} class={active === 'home' ? 'active' : ''}>Beranda</a>
						<a href={`${base}/rangkuman`} class={active === 'rangkuman' ? 'active' : ''}>Rangkuman</a>
						<a href={`${base}/soal-uts`} class={active === 'soal-uts' ? 'active' : ''}>Soal UTS</a>
						<a href={`${base}/latihan`} class={active === 'latihan' ? 'active' : ''}>Latihan</a>
					</div>
					<SearchOverlay base={base} />
					<button type="button" class="theme-toggle" id="themeToggle" aria-label="Ganti mode terang/gelap" aria-pressed="false">
						<svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
						</svg>
						<svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
						</svg>
					</button>
				</div>
			</div>
		</nav>

		<div class="scrim" id="scrim" hidden></div>
		<aside class="drawer" id="drawer" aria-label="Daftar isi" aria-hidden="true" tabindex="-1">
			<div class="drawer-head">
				<span>Daftar Isi</span>
				<button type="button" class="drawer-close" id="drawerClose" aria-label="Tutup daftar isi">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
				</button>
			</div>

			<div class="drawer-pages">
				<a href={home} data-nav="home">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21H3z"></path></svg>
					Beranda
				</a>
				<a href={`${base}/rangkuman`} data-nav="rangkuman">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
					Rangkuman Materi
				</a>
				<a href={`${base}/soal-uts`} data-nav="soal-uts">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14v18l-7-4-7 4z"></path></svg>
					Jawaban Soal UTS
				</a>
				<a href={`${base}/latihan`} data-nav="latihan">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"></path><path d="m8 12 3 3 5-6"></path></svg>
					Latihan Soal
				</a>
			</div>

			{
				chapters.map((c) => (
					<div class="drawer-group">
						<h4><span class="drawer-dot" />Bagian {c.roman} · {c.title}</h4>
						<ul>
							{topics
								.filter((t) => t.chapter === c.n)
								.map((t) => (
									<li>
										<a
											href={`${base}/rangkuman/${t.n}`}
											class="drawer-link"
											data-topic={t.n}
										>
											<span class="drawer-num">{t.n}</span>
											{t.title}
										</a>
									</li>
								))}
						</ul>
					</div>
				))
			}
		</aside>

		{
			heading && (
				<header class="page-hero">
					<div class="wrap">
						{crumb && <p class="crumb">{crumb}</p>}
						<h1>{heading}</h1>
						{subheading && <p>{subheading}</p>}
					</div>
				</header>
			)
		}

		<main id="konten">
			<slot />
		</main>

		<footer>
			<div class="wrap">
				<p>
					<b>Persiapan UTS — Manajemen Bisnis</b><br />
					Disusun dari 19 file materi kuliah • Dosen pengampu: Moh Haris, SE, M.Si<br />
					Rangkuman + Quote Tokoh + Jawaban Soal UTS + Latihan Soal
				</p>
				<p style="margin-top:10px;opacity:.7">
					Dibuat dengan Astro + React — gunakan untuk belajar, bukan menyalin buta. Selamat belajar!
				</p>
			</div>
		</footer>

		<script is:inline>
			(() => {
				const burger = document.getElementById('burger');
				const drawer = document.getElementById('drawer');
				const scrim = document.getElementById('scrim');
				const closeBtn = document.getElementById('drawerClose');
				if (!burger || !drawer || !scrim || !closeBtn) return;

				let lastFocus = null;

				const openDrawer = () => {
					lastFocus = document.activeElement;
					scrim.hidden = false;
					requestAnimationFrame(() => scrim.classList.add('show'));
					drawer.classList.add('open');
					drawer.setAttribute('aria-hidden', 'false');
					burger.setAttribute('aria-expanded', 'true');
					burger.setAttribute('aria-label', 'Tutup daftar isi');
					document.body.classList.add('nav-open');
					closeBtn.focus();
				};

				const closeDrawer = () => {
					scrim.classList.remove('show');
					drawer.classList.remove('open');
					drawer.setAttribute('aria-hidden', 'true');
					burger.setAttribute('aria-expanded', 'false');
					burger.setAttribute('aria-label', 'Buka daftar isi');
					document.body.classList.remove('nav-open');
					setTimeout(() => {
						scrim.hidden = true;
					}, 260);
					(lastFocus || burger).focus();
				};

				burger.addEventListener('click', () => {
					drawer.classList.contains('open') ? closeDrawer() : openDrawer();
				});
				closeBtn.addEventListener('click', closeDrawer);
				scrim.addEventListener('click', closeDrawer);

				document.addEventListener('keydown', (e) => {
					if (!drawer.classList.contains('open')) return;
					if (e.key === 'Escape') {
						closeDrawer();
						return;
					}
					if (e.key === 'Tab') {
						// fokus terkurung di dalam drawer
						const focusables = drawer.querySelectorAll('a[href], button');
						if (!focusables.length) return;
						const first = focusables[0];
						const last = focusables[focusables.length - 1];
						if (e.shiftKey && document.activeElement === first) {
							e.preventDefault();
							last.focus();
						} else if (!e.shiftKey && document.activeElement === last) {
							e.preventDefault();
							first.focus();
						}
					}
				});

				// Tutup drawer setelah navigasi link dalam drawer
				drawer.addEventListener('click', (e) => {
					const a = e.target.closest('a');
					if (a) closeDrawer();
				});

				// --- Navigasi aktif berdasarkan path halaman saat ini ---
				const normPath = (p) => (p || '/').replace(/\/+$/, '') || '/';
				const cur = normPath(location.pathname);
				document.querySelectorAll('.drawer-pages a[data-nav]').forEach((l) => {
					const href = normPath(l.getAttribute('href'));
					l.classList.toggle('active', href === cur);
				});
				document.querySelectorAll('.drawer-link').forEach((l) => {
					const href = normPath(l.getAttribute('href'));
					l.classList.toggle('active', href === cur);
				});

				// --- Toggle tema ---
				const toggle = document.getElementById('themeToggle');
				const root = document.documentElement;
				const systemDark = () =>
					window.matchMedia('(prefers-color-scheme: dark)').matches;
				const savedTheme = () => {
					try {
						return localStorage.getItem('theme');
					} catch {
						return null;
					}
				};
				const currentTheme = () =>
					root.getAttribute('data-theme') ||
					(systemDark() ? 'dark' : 'light');
				const syncToggle = () => {
					toggle.setAttribute(
						'aria-pressed',
						String(currentTheme() === 'dark')
					);
				};
				// Normalisasi atribut data-theme (agar semua gaya dark ikut aktif)
				if (!savedTheme()) {
					root.setAttribute('data-theme', systemDark() ? 'dark' : 'light');
					window
						.matchMedia('(prefers-color-scheme: dark)')
						.addEventListener('change', (e) => {
							if (savedTheme()) return;
							root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
							syncToggle();
						});
				}
				toggle.addEventListener('click', () => {
					const next = currentTheme() === 'dark' ? 'light' : 'dark';
					root.setAttribute('data-theme', next);
					try {
						localStorage.setItem('theme', next);
					} catch {}
					syncToggle();
				});
				syncToggle();
			})();
		</script>
	</body>
</html>
